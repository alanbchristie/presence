# Copy this file to .env and edit. Docker Compose reads .env automatically
# from the same directory as docker-compose.yml.

# Django DEBUG mode. Accepts 1/0, true/false, yes/no, on/off (case-insensitive).
# Defaults to False (secure) if unset. This template sets True for local dev;
# leave it False (or unset) for anything other than local development.
DJANGO_DEBUG=True

# Django SECRET_KEY. REQUIRED when DJANGO_DEBUG is off: the app refuses to start
# with an empty key in production rather than fall back to a publicly known dev
# key. (With DEBUG on, an insecure dev key is used automatically.) Generate a
# strong value for any non-dev deployment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Docker image tag to run for the web service. The image name is fixed to
# alanbchristie/presence (the image published by the release workflow); this
# selects which tag of it to use. Leave as 'latest' (default) to build locally
# with `docker compose build` / `up --build`. To run a published release
# without building, set this to that version (e.g. 1.3.0) and pull it first:
#   docker compose pull && docker compose up -d
PRESENCE_TAG=latest

# HTTP server. One of: runserver | gunicorn
#   runserver - Django's dev server (default). Fine for local development only.
#   gunicorn  - Production WSGI. Recommended for non-dev use.
# In both cases the server runs single-worker because the in-process runner
# thread would race across workers.
PRESENCE_SERVER=runserver

# Host interface the web container's port 8000 is published on. Defaults to
# 127.0.0.1 (loopback) so that, under the TLS profile, the plain-HTTP app is
# not reachable from outside the host — only Caddy is. Set to 0.0.0.0 only for
# a plain-HTTP deployment that must accept external traffic directly.
PRESENCE_WEB_BIND=127.0.0.1

# Password assigned to the auto-created `admin` superuser on first boot. No
# superuser is created unless this is set (there is no default password), so set
# a strong value before first boot to get an admin login.
DJANGO_SUPERUSER_PASSWORD=
# Email address assigned to the auto-created `admin` superuser on first boot.
# Defaults to info@example.com if unset.
DJANGO_SUPERUSER_EMAIL=

# --- TLS (Caddy sidecar, opt-in via 'docker compose --profile tls up -d') ---
# Public hostname for which Caddy will obtain a Let's Encrypt certificate.
# Leave as 'localhost' (default) to use Caddy's internal CA for local testing.
# docker-compose feeds this into DJANGO_ALLOWED_HOSTS and
# DJANGO_CSRF_TRUSTED_ORIGINS automatically, so the admin login form works
# over HTTPS without extra configuration.
PRESENCE_DOMAIN=localhost
# Email address ACME registers with Let's Encrypt for expiry notifications.
# Defaults to me@example.com if unset (placeholder; set this to a real
# address you control for any deployment that uses Let's Encrypt).
CADDY_EMAIL=
